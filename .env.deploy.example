# A DNS hostname you control, pointing to your VM. Do not include https:// or a path.
ANVAYA_DOMAIN=logs.example.com
ANVAYA_OPERATOR_NAME=ANVAYA project team
ANVAYA_SUPPORT_CONTACT=anvaya-sih@proton.me
# Optional hosted AI. Place the key in secrets/ai/gemini-api.key on the VM, mode 600.
ANVAYA_AI_ENABLED=0
ANVAYA_AI_MODEL=gemini-3.5-flash-lite
# Enable only after deciding which data the provider may receive; user consent is also required.
ANVAYA_AI_EVIDENCE_ENABLED=0
